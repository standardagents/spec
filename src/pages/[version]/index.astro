---
import { getVersions, getDefaultPage } from '../../lib/content'

export async function getStaticPaths() {
  const versions = await getVersions()
  return versions.map(version => ({ params: { version } }))
}

const { version } = Astro.params
const defaultPage = await getDefaultPage(version!)

const redirectUrl = defaultPage
  ? `/${version}/${defaultPage.group}/${defaultPage.slug}`
  : '/'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
    <link rel="canonical" href={redirectUrl} />
    <script define:vars={{ redirectUrl }}>
      window.location.replace(redirectUrl);
    </script>
  </head>
  <body></body>
</html>
