---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Sidebar from '../../components/Sidebar.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import Header from '../../components/Header.tsx'
import Footer from '../../components/Footer.astro'
import PageNavigation from '../../components/PageNavigation.astro'
import { getPrevNextPages } from '../../lib/content'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map(doc => {
    const [version, ...rest] = doc.id.split('/')
    const slug = rest.join('/')
    return {
      params: { version, slug },
      props: { doc }
    }
  })
}

const { version, slug } = Astro.params
const { doc } = Astro.props

// Extract title from first H1
const titleMatch = doc.body?.match(/^#\s+(.+)$/m)
const pageTitle = titleMatch ? titleMatch[1] : 'Documentation'

// Render the markdown content
const { Content, headings } = await render(doc)

// Get current path for sidebar highlighting
const currentPath = `/${version}/${slug}`

// Extract the group from the slug
const parts = slug?.split('/') || []
const group = parts[0] || ''
const isOverview = parts[parts.length - 1] === 'overview'

// Get prev/next navigation (only for non-overview pages)
const { prev, next } = isOverview
  ? { prev: null, next: null }
  : await getPrevNextPages(version!, currentPath)
---

<BaseLayout title={`${pageTitle} - Standard Agent Specification`}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
    <Header
      client:load
      currentVersion={version}
      currentGroup={group}
      currentSlug={parts[parts.length - 1] || ''}
    />
    <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8 flex-1 w-full">
      <div class="flex gap-8 max-w-full">
        <Sidebar version={version!} currentPath={currentPath} />
        <main class="min-w-0 flex-1 py-8 pb-16">
          <article class:list={['prose-content', { 'is-overview': isOverview }]}>
            <Content />
          </article>
          {!isOverview && <PageNavigation prev={prev} next={next} />}
        </main>
        <TableOfContents headings={headings} />
      </div>
    </div>
    <Footer />
  </div>
  <script>
    // Detect table overflow and scroll position
    function checkTableOverflow() {
      document.querySelectorAll('.prose-content .table-wrapper').forEach(wrapper => {
        const hasOverflow = wrapper.scrollWidth > wrapper.clientWidth
        wrapper.classList.toggle('has-overflow', hasOverflow)

        // Track scroll position for sticky column shadow
        if (hasOverflow) {
          wrapper.addEventListener('scroll', () => {
            const isScrolled = wrapper.scrollLeft > 0
            const isAtEnd = wrapper.scrollLeft >= wrapper.scrollWidth - wrapper.clientWidth - 1
            wrapper.classList.toggle('is-scrolled', isScrolled)
            wrapper.classList.toggle('is-at-end', isAtEnd)
          }, { passive: true })
        }
      })
    }
    checkTableOverflow()
    window.addEventListener('resize', checkTableOverflow)
  </script>
</BaseLayout>
