---
import { getCollection, render } from 'astro:content'
import DocLayout from '../../layouts/DocLayout.astro'
import DocColumn from '../../components/DocColumn.astro'
import PageNavigation from '../../components/PageNavigation.astro'
import PageActions from '../../components/PageActions.astro'
import { getLatestVersion, getPrevNextPages } from '../../lib/content'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map(doc => {
    const [version, ...rest] = doc.id.split('/')
    const slug = rest.join('/')
    return {
      params: { version, slug },
      props: { doc }
    }
  })
}

const { version, slug } = Astro.params
const { doc } = Astro.props

// Extract title from first H1
const titleMatch = doc.body?.match(/^#\s+(.+)$/m)
const pageTitle = titleMatch ? titleMatch[1] : 'Documentation'

// Render the markdown content
const { Content, headings } = await render(doc)

// Get current path for sidebar highlighting
const currentPath = `/${version}/${slug}`
const markdownPath = `${currentPath}.md`

// Extract the group from the slug
const parts = slug?.split('/') || []
const group = parts[0] || ''
const subSlug = parts.slice(1).join('/')
const isOverview = parts[parts.length - 1] === 'overview'
const latestVersion = await getLatestVersion()
const showPageActions = version === latestVersion

// Get prev/next navigation (only for non-overview pages)
const { prev, next } = isOverview
  ? { prev: null, next: null }
  : await getPrevNextPages(version!, currentPath)
---

<DocLayout
  title={`${pageTitle} - Standard Agent Specification`}
  version={version!}
  group={group}
  subSlug={subSlug}
  currentPath={currentPath}
  headings={headings}
>
  <DocColumn headings={headings}>
    {showPageActions && <PageActions markdownUrl={markdownPath} />}
    <article class:list={['prose-content', { 'is-overview': isOverview }]}>
      <Content />
    </article>
    {!isOverview && <PageNavigation prev={prev} next={next} />}
  </DocColumn>
</DocLayout>
