---
import DocLayout from '../layouts/DocLayout.astro'
import DocColumn from '../components/DocColumn.astro'
import PageActions from '../components/PageActions.astro'
import AgentStory from '../components/AgentStory.tsx'
import { getLatestVersion, resolveLatestLinks } from '../lib/content'
import { compiledContent, getHeadings } from '../data/home.md'

const version = await getLatestVersion()
const headings = getHeadings()

// Markdown cannot host an island, so the story sits between two halves of the
// rendered page, at the marker in its Markdown.
const parts = resolveLatestLinks(await compiledContent(), version).split(/<div data-agent-story(?:="")?><\/div>/)
if (parts.length !== 2) {
  throw new Error('Expected one data-agent-story marker in src/data/home.md')
}
---

<DocLayout version={version} currentPath="/" headings={headings}>
  <DocColumn headings={headings}>
    <PageActions markdownUrl="/index.md" />
    <article class="prose-content is-overview" set:html={parts[0]} />
  </DocColumn>
  <div class="mt-20 px-4 sm:px-6 lg:pr-8 lg:pl-12">
    <div class="mx-auto w-full max-w-[88rem] border-y border-gray-200 dark:border-gray-800">
      <AgentStory client:visible />
    </div>
  </div>
  <DocColumn headings={headings}>
    <article class="prose-content is-overview" set:html={parts[1]} />
  </DocColumn>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach((button) => {
      const label = button.querySelector('[data-copy-label]')
      let resetTimer: number | undefined
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyCommand ?? '')
        } catch (error) {
          console.error(error)
          return
        }
        if (!label) return
        label.textContent = 'Copied'
        window.clearTimeout(resetTimer)
        resetTimer = window.setTimeout(() => {
          label.textContent = 'Copy'
        }, 1600)
      })
    })
  </script>
  <script>
    const DURATION = 220
    const EASING = 'cubic-bezier(0.22, 1, 0.36, 1)'
    const items = [...document.querySelectorAll<HTMLDetailsElement>('details.faq-item')]
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const running = new WeakMap<HTMLDetailsElement, Animation>()

    // The browser's exclusive `name` group closes items instantly, so this
    // script takes over exclusivity when it runs.
    items.forEach((item) => item.removeAttribute('name'))

    function isOpening(item: HTMLDetailsElement) {
      return item.open && !item.hasAttribute('data-closing')
    }

    function toggle(item: HTMLDetailsElement, opening: boolean) {
      const startHeight = item.offsetHeight
      running.get(item)?.cancel()
      item.open = true
      item.toggleAttribute('data-closing', !opening)

      if (reducedMotion.matches) {
        item.open = opening
        item.removeAttribute('data-closing')
        return
      }

      const summary = item.querySelector('summary')!
      const border = item.offsetHeight - item.clientHeight
      const endHeight = opening ? item.offsetHeight : summary.offsetHeight + border

      item.style.overflow = 'clip'
      const animation = item.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: DURATION, easing: EASING },
      )
      item.querySelectorAll('p').forEach((answer) => {
        answer.animate(
          { opacity: opening ? [0, 1] : [1, 0] },
          { duration: DURATION, easing: 'ease' },
        )
      })
      running.set(item, animation)
      animation.onfinish = () => {
        item.open = opening
        item.removeAttribute('data-closing')
        item.style.overflow = ''
      }
    }

    items.forEach((item) => {
      item.querySelector('summary')!.addEventListener('click', (event) => {
        event.preventDefault()
        const opening = !isOpening(item)
        if (opening) {
          items.filter((other) => other !== item && isOpening(other)).forEach((other) => toggle(other, false))
        }
        toggle(item, opening)
      })
    })
  </script>
</DocLayout>
