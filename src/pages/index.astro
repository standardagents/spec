---
import { getLatestVersion, getDefaultPage } from '../lib/content'

const latestVersion = await getLatestVersion()
const defaultPage = await getDefaultPage(latestVersion)

const redirectUrl = defaultPage
  ? `/${latestVersion}/${defaultPage.group}/${defaultPage.slug}`
  : `/${latestVersion}`
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
    <link rel="canonical" href={redirectUrl} />
    <script define:vars={{ redirectUrl }}>
      window.location.replace(redirectUrl);
    </script>
  </head>
  <body></body>
</html>
