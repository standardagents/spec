---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to h2 and h3 only
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <nav class="hidden xl:block w-56 shrink-0">
    <div class="sticky top-24">
      <h4 class="font-label text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">
        On this page
      </h4>
      <ul class="space-y-2 text-xs">
        {tocHeadings.map(heading => (
          <li class={heading.depth === 3 ? 'ml-3' : ''}>
            <a
              href={`#${heading.slug}`}
              class="block text-gray-400 hover:text-gray-600 hover:underline dark:text-gray-500 dark:hover:text-gray-400 transition-colors"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}
