---
import { getAllDocs, getLatestVersion } from '../lib/content'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const latest = await getLatestVersion()
const docs = await getAllDocs()
const pathname = Astro.url.pathname
const doc = docs.find(entry => `/${entry.id}` === pathname.replace(/\/$/, ''))
const version = doc?.id.split('/')[0] ?? latest
const url = (path: string) => new URL(path, Astro.site).href
// Use the same canonical organization ID on standardagents.ai.
const organizationId = 'https://standardagents.ai/#organization'
const websiteId = url('/#website')
const specificationId = url(version === latest ? '/#specification' : `/${version}/#specification`)
const pageUrl = url(pathname)
const pageId = `${pageUrl}#webpage`
const breadcrumbId = `${pageUrl}#breadcrumb`
const versionDocs = docs.filter(entry => entry.id.startsWith(`${version}/`))
const pageTitle = doc?.body?.match(/^#\s+(.+)$/m)?.[1] ?? title
// Group headings have no landing page. Include only real ancestor documents.
const ancestors = doc ? versionDocs.filter(entry => doc.id.startsWith(`${entry.id}/`))
  .sort((a, b) => a.id.split('/').length - b.id.split('/').length) : []
const trail = [
  { name: 'Standard Agent Specification', item: url('/') },
  ...ancestors.map(entry => ({
    name: entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? entry.id,
    item: url(`/${entry.id}/`),
  })),
  { name: pageTitle, item: pageUrl },
]
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite', '@id': websiteId,
      name: 'Standard Agent Specification', url: url('/'),
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'Organization', '@id': organizationId,
      name: 'Standard Agents', url: 'https://standardagents.ai/',
      sameAs: ['https://github.com/standardagents'],
    },
    {
      '@type': 'CreativeWork', '@id': specificationId,
      additionalType: 'https://www.wikidata.org/wiki/Q317623',
      name: 'Standard Agent Specification', version,
      license: 'https://spdx.org/licenses/MIT.html',
      publisher: { '@id': organizationId },
      url: version === latest ? url('/') : url(`/${version}/getting-started/overview/`),
      hasPart: versionDocs.map(entry => ({ '@id': `${url(`/${entry.id}/`)}#webpage` })),
    },
    {
      '@type': 'WebPage', '@id': pageId,
      name: pageTitle, description, url: pageUrl,
      isPartOf: { '@id': doc ? specificationId : websiteId },
      ...(pathname === '/' ? { about: { '@id': specificationId } } : { breadcrumb: { '@id': breadcrumbId } }),
    },
    ...(pathname === '/' ? [] : [{
      '@type': 'BreadcrumbList', '@id': breadcrumbId,
      itemListElement: trail.map((item, index) => ({
        '@type': 'ListItem', position: index + 1, ...item,
      })),
    }]),
  ],
}
// Escape '<' so Markdown titles cannot terminate the JSON-LD script element.
const json = JSON.stringify(graph).replaceAll('<', '\\u003c')
---

<script is:inline type="application/ld+json" set:html={json} />
