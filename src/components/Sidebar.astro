---
import { getNavigation } from '../lib/content'
import { navGroupIcons } from '../lib/nav-icons'

interface Props {
  version: string
  currentPath: string
}

const { version, currentPath } = Astro.props
const navigation = await getNavigation(version)
---

<aside class="fixed bottom-0 left-0 top-16 z-30 hidden w-64 border-r border-gray-200 lg:block dark:border-gray-800">
  <div class="h-full overflow-y-auto px-3 py-6">
    <nav class="space-y-7">
      {navigation.map((group) => (
        <div>
          {/* original: text-gray-500 dark:text-gray-400 */}
          <h3 class="mb-2 px-3 flex items-center gap-2 text-sm leading-5 font-semibold text-gray-900 dark:text-gray-100">
            <svg class="h-4 w-4 flex-none text-gray-500 dark:text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={navGroupIcons[group.group]} />
            {group.title}
          </h3>
          <ul class="space-y-1">
            {group.items.map((item) => {
              const isActive = currentPath === item.href
              const hasActiveChild = item.children?.some(c => currentPath === c.href) ?? false
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-md px-3 py-2 text-sm transition-colors',
                      isActive
                        ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-gray-100'
                        : 'text-gray-800 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100' /* original: text-gray-600 dark:text-gray-400 */
                    ]}
                  >
                    {item.title}
                  </a>
                  {item.children && (isActive || hasActiveChild) && (
                    <ul class="ml-3 mt-1 space-y-1 border-l border-gray-200 pl-3 dark:border-gray-700">
                      {item.children.map((child) => {
                        const childActive = currentPath === child.href
                        return (
                          <li>
                            <a
                              href={child.href}
                              class:list={[
                                'block rounded-md px-3 py-1.5 text-sm transition-colors',
                                childActive
                                  ? 'bg-gray-100 font-medium text-gray-900 dark:bg-gray-800 dark:text-gray-100'
                                  : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100'
                              ]}
                            >
                              {child.title}
                            </a>
                          </li>
                        )
                      })}
                    </ul>
                  )}
                </li>
              )
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</aside>
