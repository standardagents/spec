---
import { getNavigation } from '../lib/content'

interface Props {
  version: string
  currentPath: string
}

const { version, currentPath } = Astro.props
const navigation = await getNavigation(version)
---

<aside class="hidden w-56 flex-shrink-0 lg:block">
  <div class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto py-8 pr-4">
    <nav class="space-y-6">
      {navigation.map((group) => (
        <div>
          {/* original: text-gray-500 dark:text-gray-400 */}
          <h3 class="mb-2 font-label text-xs font-medium uppercase tracking-wider text-gray-700 dark:text-gray-300">
            {group.title}
          </h3>
          <ul class="space-y-1">
            {group.items.map((item) => {
              const isActive = currentPath === item.href
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
                      isActive
                        ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-gray-100'
                        : 'text-gray-800 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100' /* original: text-gray-600 dark:text-gray-400 */
                    ]}
                  >
                    {item.title}
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</aside>
