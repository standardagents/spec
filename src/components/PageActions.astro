---
interface Props {
  markdownUrl: string
}

const { markdownUrl } = Astro.props
---

<div class="mb-6 flex justify-end" data-page-actions data-markdown-url={markdownUrl}>
  <details class="relative">
    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 font-label text-sm font-medium text-gray-900 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:hover:border-gray-600 dark:hover:bg-gray-700">
      <svg class="h-4 w-4 text-gray-500 dark:text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="9" y="9" width="10" height="10" rx="2"></rect>
        <path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
      </svg>
      <span data-summary-label>Copy page</span>
      <svg class="h-3.5 w-3.5 text-gray-500 transition-transform dark:text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.939a.75.75 0 1 1 1.08 1.04l-4.25 4.51a.75.75 0 0 1-1.08 0l-4.25-4.51a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
      </svg>
    </summary>

    <div class="absolute right-0 top-[calc(100%+0.5rem)] z-20 w-72 rounded-2xl border border-gray-200 bg-white p-2 shadow-xl dark:border-gray-700 dark:bg-gray-800">
      <button
        type="button"
        data-copy-markdown
        class="flex w-full items-start gap-3 rounded-xl px-3 py-3 text-left transition hover:bg-gray-50 dark:hover:bg-gray-700"
      >
        <span class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-500 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="9" y="9" width="10" height="10" rx="2"></rect>
            <path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block font-label text-sm font-medium text-gray-900 dark:text-gray-100">Copy page</span>
          <span class="block text-sm text-gray-600 dark:text-gray-400">Copy page as Markdown for LLMs</span>
        </span>
      </button>

      <a
        href={markdownUrl}
        data-astro-prefetch="false"
        target="_blank"
        rel="noreferrer"
        class="flex items-start gap-3 rounded-xl px-3 py-3 transition hover:bg-gray-50 dark:hover:bg-gray-700"
      >
        <span class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50 text-gray-500 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-300">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M14 5h5v5"></path>
            <path d="M10 14 19 5"></path>
            <path d="M19 14v3a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3"></path>
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block font-label text-sm font-medium text-gray-900 dark:text-gray-100">View as Markdown</span>
          <span class="block text-sm text-gray-600 dark:text-gray-400">View this page as plain text</span>
        </span>
      </a>
    </div>
  </details>
</div>

<style>
  [data-page-actions] summary::-webkit-details-marker {
    display: none;
  }

  [data-page-actions] details[open] summary svg:last-child {
    transform: rotate(180deg);
  }
</style>

<script>
  import { onPage } from '../lib/page-lifecycle'

  const copyText = async (text) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text)
      return
    }

    const textarea = document.createElement('textarea')
    textarea.value = text
    textarea.setAttribute('readonly', '')
    textarea.style.position = 'absolute'
    textarea.style.left = '-9999px'
    document.body.appendChild(textarea)
    textarea.select()
    document.execCommand('copy')
    textarea.remove()
  }

  onPage('page-actions', () => {
    document.querySelectorAll('[data-page-actions]').forEach((container) => {
      const details = container.querySelector('details')
      const copyButton = container.querySelector('[data-copy-markdown]')
      const summaryLabel = container.querySelector('[data-summary-label]')
      const markdownUrl = container.getAttribute('data-markdown-url')
      let resetTimer

      copyButton?.addEventListener('click', async (event) => {
        event.preventDefault()
        if (!markdownUrl) return

        try {
          const response = await fetch(markdownUrl)
          if (!response.ok) {
            throw new Error(`Failed to fetch ${markdownUrl}`)
          }

          const markdown = await response.text()
          await copyText(markdown)

          if (summaryLabel) {
            summaryLabel.textContent = 'Copied'
            window.clearTimeout(resetTimer)
            resetTimer = window.setTimeout(() => {
              summaryLabel.textContent = 'Copy page'
            }, 1600)
          }

          if (details) {
            details.open = false
          }
        } catch (error) {
          console.error(error)
        }
      })
    })
  })
</script>
